{
  "schema": "physical-ai.seggrpo-training-config.v2",
  "split": "train",
  "environment_seed": 42,
  "seed": 42,
  "execution_group_size": 8,
  "qa_group_size": 8,
  "execution_steps": 128,
  "qa_steps": 32,
  "execution_token_budget": 6144,
  "qa_token_budget": 6144,
  "judge_model": "gpt-5.6-sol",
  "task_rule": {
    "version": "rl-device-state-goal-v1",
    "target_state": "open",
    "calibration": "libero-scene-map-draft-2+asset-supports-v1",
    "native_success_is_diagnostic_only": true,
    "task_name": "open_the_middle_drawer_of_the_cabinet",
    "query": {
      "op": "attribute",
      "entity": "wooden_cabinet_1/wooden_cabinet_1_cabinet_middle",
      "path": "states.wooden_cabinet_1_middle_level.value"
    },
    "allowed_states": [
      "open",
      "closed",
      "partially_open"
    ]
  },
  "sampling_mode": "recompute",
  "compute_dtype": "float32",
  "optimizer": "adamw",
  "learning_rate": 1e-06,
  "max_grad_norm": 1.0,
  "project": "physical-ai-rl",
  "experiment": "reactpi-epoch20-seggrpo-b128-m32-n8",
  "logger": [
    "console",
    "swanlab"
  ],
  "batch_size": 128,
  "mini_batch_size": 32,
  "micro_batch_size_per_gpu": 1,
  "ppo_epochs": 1,
  "adam_betas": [
    0.9,
    0.999
  ],
  "adam_eps": 1e-08,
  "weight_decay": 0.0,
  "optimizer_state_sharding": true,
  "parallel_rollouts": true,
  "collective_timeout_minutes": 720,
  "clip_ratio": 0.2,
  "behavior_logprob_tolerance": 0.05,
  "total_training_steps": 100,
  "save_freq": 10,
  "max_ckpt_to_keep": 1,
  "clip_ratio_c": 3.0,
  "advantage_estimator": "seggrpo",
  "norm_adv_by_std_in_grpo": true,
  "advantage_epsilon": 1e-06,
  "loss_agg_mode": "seq-mean-token-mean",
  "execution_loss_weight": 1.0,
  "qa_loss_weight": 1.0,
  "parent_selection": "uniform",
  "temperature": 1.0,
  "top_p": 1.0,
  "top_k": -1,
  "use_kl_loss": false,
  "kl_loss_coef": 0.0,
  "entropy_coeff": 0.0,
  "lr_scheduler_type": "constant",
  "lr_warmup_steps": 0
}
