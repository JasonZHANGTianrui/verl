{
  "schema": "physical-ai.rl-reward-contract.draft-v1",
  "status": "draft_not_runnable",
  "task": {
    "source": "versioned_task_monitor",
    "rule_ref": null,
    "native_success_is_diagnostic_only": true
  },
  "qa": {
    "source": "same_rollout_scene_map_pop",
    "question_selection": "fixed_before_rollout",
    "gt_anchor": "question_delivery",
    "response": "qa_turn_public_assistant_text",
    "judge": {
      "implementation": "benchmark.scoring.llm_judge.judge_answer",
      "model": "gpt-5.6-sol",
      "rubric_version": "execution-qa-text-judge-v2.1",
      "access_file_env": "PHYSICAL_AI_JUDGE_ACCESS_FILE",
      "timeout_seconds": 60,
      "max_attempts": 3,
      "max_concurrency": 8,
      "cache_key_fields": [
        "question_definition_hash",
        "question_text",
        "ground_truth_content_hash",
        "answer_content_hash",
        "judge_model_revision",
        "rubric_sha256"
      ]
    }
  },
  "combination": {
    "kind": "separate_segment_grpo_losses",
