  "errors": {
    "judge_failure": "retry_same_answer_then_block_group",
    "undetermined_ground_truth": "block_group_for_diagnosis",
    "simulator_failure": "invalid_rollout_not_zero_reward"
  },
  "algorithm": {
    "name": "seggrpo",
    "base_estimator": "grpo",
    "execution_group_size": null,
    "qa_group_size": null,
    "parent_selection": "uniform_without_success_filter",
    "qa_parents_per_execution_group": 1,
    "shared_behavior_policy_version": true,
    "update_after_both_groups_collected": true,
    "normalize_advantages": "within_phase_and_condition",
    "zero_reward_variance": "zero_advantage"
  }
}
